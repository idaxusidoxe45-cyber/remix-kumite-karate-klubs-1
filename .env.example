# Notification Email Target (overridable in Admin Settings when Upstash KV is connected)
NOTIFICATION_EMAIL="info@kumitekarate.lv"

# Serverless Cloud Persistence (Upstash Redis KV)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Serverless Email Delivery (Resend API)
RESEND_API_KEY=""

# Admin Panel Server-Side Security (recommended for production)
ADMIN_SESSION_SECRET=""
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""

# Optional Cloudinary Direct Upload (bypasses 4.5MB Vercel serverless payload limit)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
